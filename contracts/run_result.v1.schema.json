    "DEGRADED_MODE",
    "GUARDRAIL_TRIGGERED",
    "BUDGET_EXHAUSTED",
    "INCOMPLETE_RUN"
   ],
   "title": "EscalationReason",
   "type": "string"
  },
  "Fault": {
   "enum": [
    "BANK",
    "THIRD_PARTY",
    "CUSTOMER_NEGLIGENCE",
    "CONTESTED",
    "NOT_UNAUTHORISED",
    "UNKNOWN"
   ],
   "title": "Fault",
   "type": "string"
  },
  "LiabilityBand": {
   "enum": [
    "ZERO",
    "LIMITED",
