  },
  "summary": {
   "title": "Summary",
   "type": "string"
  },
  "basis": {
   "title": "Basis",
   "type": "string"
  },
  "claims": {
   "items": {
    "$ref": "#/$defs/Claim"
   },
   "title": "Claims",
   "type": "array"
  },
  "citations": {
   "items": {
    "$ref": "#/$defs/Citation"
   },
   "title": "Citations",
   "type": "array"
  },
  "escalation_reasons": {
   "items": {
    "$ref": "#/$defs/EscalationReason"
   },
   "title": "Escalation Reasons",
   "type": "array"
  },
  "escalation_path": {
   "default": "",
   "title": "Escalation Path",
   "type": "string"
  },
  "verification": {
   "anyOf": [
    {
     "$ref": "#/$defs/VerificationReport"
    },
    {
     "type": "null"
    }
   ],
   "default": null
