    "chunk_id": {
     "title": "Chunk Id",
     "type": "string"
    },
    "clause_id": {
     "title": "Clause Id",
     "type": "string"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "quote": {
     "title": "Quote",
     "type": "string"
    },
    "source_url": {
