   "type": "string"
  },
  "prompt_versions": {
   "additionalProperties": {
    "type": "string"
   },
   "title": "Prompt Versions",
   "type": "object"
  },
  "cost_usd": {
   "default": 0.0,
   "title": "Cost Usd",
   "type": "number"
  },
  "tokens": {
   "additionalProperties": {
    "type": "integer"
   },
   "title": "Tokens",
   "type": "object"
  }
 },
 "required": [
  "run_id",
  "completed",
  "route",
  "liability_band",
  "summary",
  "basis"
 ],
