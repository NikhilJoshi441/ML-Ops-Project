   "type": "string"
  },
  "VerificationReport": {
   "properties": {
    "passed": {
     "title": "Passed",
     "type": "boolean"
    },
    "attempts": {
     "title": "Attempts",
     "type": "integer"
    },
    "checks": {
     "additionalProperties": true,
     "title": "Checks",
     "type": "object"
    },
    "failures": {
     "items": {
      "type": "string"
     },
     "title": "Failures",
     "type": "array"
    }
   },
   "required": [
    "passed",
    "attempts"
   ],
   "title": "VerificationReport",
   "type": "object"
  }
 },
 "description": "What the caller receives. Never an instruction to credit or close: an\nanalyst decides (section 2 of the brief).",
