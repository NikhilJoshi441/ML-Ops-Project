    "UPI_SOCIAL_ENGINEERING",
    "MERCHANT_DISPUTE",
    "DUPLICATE_CHARGE",
    "OUT_OF_SCOPE"
   ],
   "title": "Category",
   "type": "string"
  },
  "Citation": {
