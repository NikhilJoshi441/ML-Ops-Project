{
 "title": "Card dispute triage",
 "uid": "dispute-triage",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "row",
   "title": "Service level (complete runs, submission -> final result)",
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Run latency p50 / p95 (SLO p95 <= 60 s)",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(run_e2e_latency_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(run_e2e_latency_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Throughput (runs completed / s) and submissions",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(run_e2e_latency_seconds_count[1m]))",
     "legendFormat": "completed"
    },
    {
     "refId": "B",
     "expr": "sum(rate(disputes_submitted_total[1m]))",
     "legendFormat": "submitted"
    },
    {
     "refId": "C",
     "expr": "sum(rate(disputes_rejected_total[1m]))",
     "legendFormat": "rejected (quarantined)"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error rate",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(run_e2e_latency_seconds_count{outcome=\"incomplete\"}[5m])) / clamp_min(sum(rate(run_e2e_latency_seconds_count[5m])),1e-9)",
     "legendFormat": "incomplete runs"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),1e-9)",
     "legendFormat": "HTTP 5xx"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Availability (targets up)",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg by (job) (up)",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "HTTP p95 latency by service",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Queue depth",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (queue) (queue_depth)",
     "legendFormat": "{{queue}}"
    },
    {
     "refId": "B",
     "expr": "sum by (agent) (worker_in_flight)",
     "legendFormat": "in flight {{agent}}"
    }
   ]
  },
  {
   "type": "row",
   "title": "Agents",
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Task success rate by agent",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_runs_total{outcome=\"success\"}[5m])) / clamp_min(sum by (agent) (rate(agent_runs_total[5m])),1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Steps and tool calls per run (mean)",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_steps_per_run_sum[5m])) / clamp_min(sum by (agent) (rate(agent_steps_per_run_count[5m])),1e-9)",
     "legendFormat": "steps {{agent}}"
    },
    {
     "refId": "B",
     "expr": "sum by (agent) (rate(agent_tool_calls_per_run_sum[5m])) / clamp_min(sum by (agent) (rate(agent_tool_calls_per_run_count[5m])),1e-9)",
     "legendFormat": "tool calls {{agent}}"
    },
    {
     "refId": "C",
     "expr": "sum by (agent) (rate(agent_llm_calls_per_run_sum[5m])) / clamp_min(sum by (agent) (rate(agent_llm_calls_per_run_count[5m])),1e-9)",
     "legendFormat": "llm calls {{agent}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retry rate by agent (retries / calls)",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(agent_retries_total[5m])) / clamp_min(sum by (agent) (rate(agent_calls_total[5m])),1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
