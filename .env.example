# Copy to .env and fill in. Nothing environment-specific lives in the repository (D4):
# endpoints, credentials, model identifiers and prices are injected here at runtime.

# ---- LLM provider (read only by llm-gateway) --------------------------------
# Any OpenAI-compatible chat-completions endpoint. Options:
#   * keyless local run / load test : LLM_BASE_URL=http://llm-stub:8090/v1   LLM_MODEL=stub
#   * Ollama on the host            : LLM_BASE_URL=http://host.docker.internal:11434/v1 and the pulled model tag
#   * a hosted free tier            : the provider's OpenAI-compatible base URL, API key and model id
LLM_BASE_URL=http://llm-stub:8090/v1
LLM_MODEL=stub
LLM_API_KEY=
# Optional secondary provider tried when the primary's circuit is open (degradation path step 2)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Prices in USD per 1M tokens, used for cost accounting at call time (set to your provider's list price)
LLM_PRICE_PROMPT_PER_1M=0.05
LLM_PRICE_COMPLETION_PER_1M=0.08
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_S=60
BREAKER_OPEN_S=30
LLM_CACHE_ENABLED=true

# ---- Embeddings (ingest + retriever) -----------------------------------------
# A sentence-transformers model id, downloaded once into the hf-cache volume.
# The project was built and measured with the small MiniLM-L6-v2 sentence-transformers model.
EMBEDDING_MODEL=

# ---- Agents -------------------------------------------------------------------
PROMPT_VARIANT=v2
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_WALL_CLOCK_S=120
AGENT_MAX_VERIFICATION_ATTEMPTS=2
GATEWAY_CALL_TIMEOUT_S=75
SUPPORT_THRESHOLD=0.55
ONLINE_EVAL_SAMPLE_RATE=0.2
# Evaluation only: lets eval/run_eval.py choose prompt variant / retrieval profile per request
ALLOW_EXPERIMENT_OVERRIDES=false

# ---- API ------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
MAX_QUEUE_DEPTH=500

# ---- LLM stub (load testing) ---------------------------------------------------
STUB_DELAY_MEAN_MS=1200
STUB_DELAY_SIGMA=0.35

# ---- Misc -----------------------------------------------------------------------
LOG_LEVEL=INFO
EXTRA_HOLIDAYS=
GRAFANA_ADMIN_PASSWORD=change-me
